<!--
  Triple moon / triple goddess symbol — the Max AI logo.
  ViewBox: 200 × 88  (units match the SwiftUI 100×44 grid × 2)

  Left crescent:  outer circle cx=30 r=42, inner circle cx=48 r=32 (offset right → crescent opens right)
  Center ring:    outer circle cx=100 r=28, inner circle cx=100 r=18
  Right crescent: outer circle cx=170 r=42, inner circle cx=152 r=32 (offset left → crescent opens left)

  Crescent arcs use the SVG arc trick:
    Draw outer circle as two semicircular arcs (CW), then
    subtract inner circle as two semicircular arcs (CCW).
    fillType="evenOdd" punches the hole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="88dp"
    android:viewportWidth="200"
    android:viewportHeight="88">

    <!-- ── Left crescent ──────────────────────────────────────────────────── -->
    <!--
      Outer circle: cx=30, cy=44, r=42  → left=-12, right=72, top=2, bottom=86
      Inner circle: cx=48, cy=44, r=32  → left=16,  right=80, top=12, bottom=76

      Path: move to top of outer (30, 2)
        Arc CW bottom half: (30,86)
        Arc CW top half:    back to (30,2)
        Move to top of inner (48,12)
        Arc CCW bottom half: (48,76)
        Arc CCW top half:    back to (48,12)
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
          M 30,2
          A 42,42 0 0,1 30,86
          A 42,42 0 0,1 30,2 Z
          M 48,12
          A 32,32 0 0,0 48,76
          A 32,32 0 0,0 48,12 Z" />

    <!-- ── Center ring ─────────────────────────────────────────────────────── -->
    <!--
      Outer circle: cx=100, cy=44, r=28  → top=16, bottom=72
      Inner circle: cx=100, cy=44, r=18  → top=26, bottom=62
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
          M 100,16
          A 28,28 0 0,1 100,72
          A 28,28 0 0,1 100,16 Z
          M 100,26
          A 18,18 0 0,0 100,62
          A 18,18 0 0,0 100,26 Z" />

    <!-- ── Right crescent ─────────────────────────────────────────────────── -->
    <!--
      Outer circle: cx=170, cy=44, r=42  → left=128, right=212, top=2, bottom=86
      Inner circle: cx=152, cy=44, r=32  → left=120, right=184, top=12, bottom=76
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
          M 170,2
          A 42,42 0 0,0 170,86
          A 42,42 0 0,0 170,2 Z
          M 152,12
          A 32,32 0 0,1 152,76
          A 32,32 0 0,1 152,12 Z" />

</vector>
