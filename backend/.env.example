# Server only: never place OPENAI_API_KEY in a mobile bundle.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=8787

# Server-only OpenAI voice. Existing text generation model stays unchanged.
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini
# Production for App Store; Sandbox only for a separate TestFlight backend.
APPLE_STORE_ENVIRONMENT=Production
APPLE_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# JSON array of base64 DER Apple root certificates from https://www.apple.com/certificateauthority/
APPLE_ROOT_CERTIFICATES_BASE64=

# Sandbox-only max-api-beta endpoint. These are separate from Production billing.
# Add values in Supabase's server secret store; never in mobile configuration.
MAX_BETA_APPLE_IAP_KEY_ID=
MAX_BETA_APPLE_IAP_ISSUER_ID=
MAX_BETA_APPLE_IAP_PRIVATE_KEY=
MAX_BETA_APPLE_APP_ID=
MAX_BETA_APPLE_ROOT_CERTIFICATES_BASE64=
