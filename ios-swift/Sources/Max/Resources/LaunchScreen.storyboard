                        <constraints>
                            <constraint firstItem="logo-img-01" firstAttribute="centerX"
                                        secondItem="Ze5-6b-2t3" secondAttribute="centerX"
                                        id="cx-logo"/>
                            <constraint firstItem="logo-img-01" firstAttribute="centerY"
                                        secondItem="Ze5-6b-2t3" secondAttribute="centerY"
                                        id="cy-logo"/>
                            <constraint firstItem="logo-img-01" firstAttribute="width"
                                        constant="200" id="w-logo"/>
                            <constraint firstItem="logo-img-01" firstAttribute="height"
                                        constant="100" id="h-logo"/>
